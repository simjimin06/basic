generator client {
  provider = "prisma-client-js"
}

//데이터베이스에 어떤 테이블과 칼럼이 있는지 정의 

// PostgreSql 연결
datasource db {
  provider = "postgresql"
  // .env 파일의 DATABASE_URL 변수를 사용
  url      = env("DATABASE_URL")
}


//1. 사용자 모델

model User {
  // id: 기본 키
  id        String      @id @default(uuid())

  // IDP (/oauth/userInfo)를 통해 가져오는 정보 저장
  sub           String         @unique // IDP에서 제공하는 유저 고유 식별자
  name          String
  email         String         @unique
  createdAt     DateTime       @default(now())

  // 관계 설정
  posts         Post[]         // 사용자가 작성한 게시글
  subscriptions Subscription[] // 사용자가 구독한 카테고리
 
}

// 2. 카테고리 모델 (announcement, qna, misc)
model Category {
  id          Int            @id @default(autoincrement())
  name        String         @unique   // announcement, qnq, misc
  // (기본값은 true: 살아있음)
  status      Boolean        @default(true) //soft delete
  posts       Post[]         // 이 카테고리에 속한 게시글들
  subscribers Subscription[] // 이 카테고리를 구독하는 유저들
}


// 3. 게시글(Post) 모델

model Post {
  // id: 기본 키 (Primary Key), 데이터베이스에서 자동으로 1씩 증가
  id        Int      @id @default(autoincrement())
  title      String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // 작성자 관계 (User의 UUID와 연결)
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String

  // 카테고리 관계 
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
}

// 4. 구독 모델 (User <-> Category N:M 관계)
model Subscription {
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  userId     String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  // 한 유저가 같은 카테고리를 중복 구독할 수 없도록 유니크 설정
  @@id([userId, categoryId])
}
